!.aider_factory/markdown/templates/
!.aider_factory/sessions/
.aider_factory/sessions/*
!.aider_factory/sessions/*/
.aider_factory/sessions/*/*
!.aider_factory/sessions/*/session.yml
!.aider_factory/sessions/*/feature_adr/
!.aider_factory/sessions/*/templates/
